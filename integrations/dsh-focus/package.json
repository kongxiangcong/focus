{
  "name": "@focus/dsh-native",
  "version": "0.2.0-stage2d.16",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./session-lifecycle": "./session-lifecycle.js"
  },
  "files": [
    "index.js",
    "client.js",
    "session-lifecycle.js",
    "worker.py",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node --check index.js && node --check client.js && node --check session-lifecycle.js && python -m py_compile worker.py"
  }
}
