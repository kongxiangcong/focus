# Export these in the shell/service environment. This example is NOT auto-loaded.
FOCUS_WORKSPACE=/absolute/path/to/reading-workspace
FOCUS_HOST_DATA=/absolute/path/to/focus-host-data
# Omit to use the configured Codex model. No guessed/default model ID is imposed.
# FOCUS_MODEL=your-account-supported-model
# Optional: reuse the Host user's existing Codex sign-in, or configure API auth:
# OPENAI_API_KEY=replace-locally
# Parser calls need this (or a .env in Workspace, per existing parser behavior):
# MINERU_API_TOKEN=replace-locally
# Optional persistent web access token; omitted => random token printed on startup.
# FOCUS_HOST_TOKEN=replace-with-a-long-random-value
# Only for an explicitly configured private server/reverse proxy:
# FOCUS_PUBLIC_ORIGIN=https://focus.example.com
